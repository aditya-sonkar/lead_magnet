        "quote",
        "callback",
        "contact"
      ],
      "default": "quote"
    },
    "quoteForm": {
      "type": "component",
      "component": "sections.quote-form",
      "repeatable": false
    },
    "callbackForm": {
      "type": "component",
      "component": "sections.callback-form",
      "repeatable": false
    }
  }
}
