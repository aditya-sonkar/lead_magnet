{
  "kind": "collectionType",
  "collectionName": "forms",
  "info": {
    "singularName": "form",
    "pluralName": "forms",
    "displayName": "Form",
    "description": "Forms and Lead Magnet configurations"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "formName": {
      "type": "string",
      "required": true
    },
    "formType": {
      "type": "enumeration",
      "enum": [
        "quote",
        "callback",
        "contact"
      ],
      "default": "quote"
    },
    "formConfig": {
      "type": "dynamiczone",
      "components": [
        "sections.quote-form",
        "sections.callback-form"
      ],
      "min": 1,
      "max": 1
    }
  }
}
