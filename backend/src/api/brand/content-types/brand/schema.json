{
  "kind": "collectionType",
  "collectionName": "brands",
  "info": {
    "singularName": "brand",
    "pluralName": "brands",
    "displayName": "Brand",
    "description": "Brand with organized sections: Hero, Work Showcase, Our Work, Final CTA, and Gallery"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "websiteUrl": {
      "type": "string"
    },
    "hero": {
      "type": "component",
      "repeatable": false,
      "component": "brand.hero-assets"
    },
    "workShowcase": {
      "type": "component",
      "repeatable": false,
      "component": "brand.work-showcase-assets"
    },
    "ourWork": {
      "type": "component",
      "repeatable": false,
      "component": "brand.our-work-assets"
    },
    "finalCta": {
      "type": "component",
      "repeatable": false,
      "component": "brand.final-cta-assets"
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images",
        "files"
      ]
    }
  }
}
